    {
      "id": "ewt-test-028",
      "sourceSent": "weblog-blogspot.com_grandpasgripes_20060413051000_ENG_20060413_051000-0016",
      "tokens": 16,
      "text": "It does seem that Iranians frequently make statements and then hide behind lack of proof."
    },
    {
      "id": "ewt-test-029",
      "sourceSent": "weblog-juancole.com_juancole_20030914114200_ENG_20030914_114200-0003",
      "tokens": 25,
      "text": "It read, \"The people of Fallujah condemn the massacre which was committed on Friday against people dedicated to the protection of Fallujah."
