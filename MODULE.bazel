module(name = "polytype", version = "0.1.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
    rustfmt_version = "1.95.0",
    extra_target_triples = ["wasm32-unknown-unknown"],
    opt_level = {"dbg": "0", "fastbuild": "0", "opt": "s"},
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

rust_host = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host.host_tools(name = "polytype_rust_host", version = "1.95.0", rustfmt_version = "1.95.0")
use_repo(rust_host, "polytype_rust_host")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "*",
    additive_build_file_content = 'filegroup(name = "notices", srcs = glob(["LICENSE*", "Cargo.toml"]), visibility = ["//visibility:public"])',
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    host_tools = "@polytype_rust_host//:WORKSPACE.bazel",
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "wasm32-unknown-unknown"],
)
use_repo(crate, "crates",
    "crates__bumpalo-3.20.3",
    "crates__cfg-if-1.0.4",
    "crates__itoa-1.0.18",
    "crates__memchr-2.8.3",
    "crates__once_cell-1.21.4",
    "crates__proc-macro2-1.0.107",
    "crates__quote-1.0.47",
    "crates__rustversion-1.0.23",
    "crates__serde-1.0.229",
    "crates__serde_core-1.0.229",
    "crates__serde_derive-1.0.229",
    "crates__serde_json-1.0.151",
    "crates__syn-3.0.5",
    "crates__unicode-ident-1.0.24",
    "crates__wasm-bindgen-0.2.128",
    "crates__wasm-bindgen-macro-0.2.128",
    "crates__wasm-bindgen-macro-support-0.2.128",
    "crates__wasm-bindgen-shared-0.2.128",
    "crates__zmij-1.0.23",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_version = "26.8.1",
    node_repositories = {"26.8.1-linux_amd64": ("node-v26.8.1-linux-x64.tar.xz", "node-v26.8.1-linux-x64", "3e301118d7df53d563b7e96c1617545f26e2f76f9724be668d6cab65c15dda5d")},
)
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "wasm_bindgen_cli",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.128/wasm-bindgen-0.2.128-x86_64-unknown-linux-musl.tar.gz"],
    sha256 = "b51f0208fdff83515a787bd8ab9ac5865ed84dabb66d0c709957bb59793c645f",
    strip_prefix = "wasm-bindgen-0.2.128-x86_64-unknown-linux-musl",
    build_file_content = 'exports_files(["wasm-bindgen"], visibility = ["//visibility:public"])',
)
register_toolchains("//build:wasm_bindgen_toolchain")
